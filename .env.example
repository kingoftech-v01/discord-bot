# ================================
# Discord Bot Pro - Configuration
# ================================
# Copiez ce fichier en .env et remplissez les valeurs

# === TOKENS DISCORD (OBLIGATOIRE) ===
DISCORD_TOKEN=your_bot_token_here
APPLICATION_ID=your_application_id_here

# === CONFIGURATION GENERALE ===
BOT_PREFIX=!
CHANNEL_ID=0
SEND_HOUR=9

# === CONFIGURATION AI (Optionnel) ===
# Activez l'AI pour les commandes !ask, !translate, !code, etc.
AI_ENABLED=true
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-3.5-turbo

# === LEVELING ===
XP_PER_MESSAGE=15
XP_COOLDOWN=60
LEVEL_UP_BASE=100
LEVEL_UP_FACTOR=1.5

# === ECONOMIE ===
DAILY_REWARD_MIN=50
DAILY_REWARD_MAX=200
CURRENCY_NAME=coins
CURRENCY_SYMBOL=

# === MODERATION ===
WARN_THRESHOLD=3
MUTE_DURATION=3600
SPAM_THRESHOLD=5
SPAM_INTERVAL=5

# === TRIVIA ===
TRIVIA_TIME_LIMIT=30
TRIVIA_REWARD=50
