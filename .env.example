# ============================================
# Discord Bot Pro - Configuration
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# DISCORD CONFIGURATION (REQUIRED)
# ============================================

# Discord Bot Token - Get from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Application ID - Found in General Information
APPLICATION_ID=your_application_id_here

# Client Secret - Found in OAuth2 settings (required for dashboard)
DISCORD_CLIENT_SECRET=your_client_secret_here

# ============================================
# GENERAL CONFIGURATION
# ============================================

BOT_PREFIX=!
CHANNEL_ID=0
SEND_HOUR=9

# ============================================
# AI CONFIGURATION (Optional)
# ============================================

AI_ENABLED=true
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-3.5-turbo
AI_CHANNEL_ID=

# ============================================
# LEVELING SYSTEM
# ============================================

XP_PER_MESSAGE=15
XP_COOLDOWN=60
LEVEL_UP_BASE=100
LEVEL_UP_FACTOR=1.5

# ============================================
# ECONOMY SYSTEM
# ============================================

DAILY_REWARD_MIN=50
DAILY_REWARD_MAX=200
CURRENCY_NAME=coins
CURRENCY_SYMBOL=

# ============================================
# MODERATION
# ============================================

WARN_THRESHOLD=3
MUTE_DURATION=3600
SPAM_THRESHOLD=5
SPAM_INTERVAL=5

# ============================================
# TRIVIA GAMES
# ============================================

TRIVIA_TIME_LIMIT=30
TRIVIA_REWARD=50

# ============================================
# DJANGO DASHBOARD CONFIGURATION
# ============================================

# Django Secret Key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=your_django_secret_key_here

# Debug mode (False in production)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Dashboard URL for OAuth callback
DASHBOARD_URL=http://localhost:8000

# ============================================
# DATABASE CONFIGURATION
# ============================================

# SQLite (default)
DATABASE_PATH=data/bot.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@db:5432/discord_bot
POSTGRES_USER=discord_bot
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=discord_bot
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================

REDIS_URL=redis://redis:6379/0

# ============================================
# DOCKER CONFIGURATION
# ============================================

COMPOSE_PROJECT_NAME=discord-bot

# Gunicorn settings
GUNICORN_WORKERS=4
GUNICORN_THREADS=2

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ============================================
# API CONFIGURATION
# ============================================

# API rate limiting (requests per minute)
API_RATE_LIMIT=60

# API Key for external access (generate a random string)
API_SECRET_KEY=your_api_secret_key_here
